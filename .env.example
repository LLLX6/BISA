# BISA runtime. This is a template only; never commit the filled production file.
BISA_ENV=development
BISA_RELEASE=0.1.0
HOST=127.0.0.1
PORT=8080
BISA_PUBLIC_URL=http://127.0.0.1:8080
BISA_ALLOWED_ORIGINS=http://127.0.0.1:8080
BISA_SESSION_TTL_HOURS=168
BISA_MAX_JSON_BYTES=524288

# Use persistent, BISA-only paths in production.
BISA_DATA_DIR=./data-bisa
BISA_DB_PATH=./data-bisa/bisa.sqlite3
BISA_UPLOAD_DIR=./data-bisa/uploads
BISA_BACKUP_DIR=./data-bisa/backups

# Must remain false outside an isolated local demo database.
BISA_SEED_SAMPLE_DATA=false

# External adapters intentionally remain unavailable until configured.
BISA_WHATSAPP_PHONE_NUMBER_ID=
BISA_WHATSAPP_ACCESS_TOKEN=
BISA_PAYMENT_GATEWAY=unconfigured
BISA_PAYMENT_WEBHOOK_SECRET=
BISA_VAPID_PUBLIC_KEY=
BISA_VAPID_PRIVATE_KEY=
