# BISA runtime. This is a template only; never commit the filled production file.
BISA_ENV=development
BISA_RELEASE=0.2.0-dev
HOST=127.0.0.1
PORT=8080
BISA_PUBLIC_URL=http://127.0.0.1:8080
BISA_ALLOWED_ORIGINS=http://127.0.0.1:8080
BISA_SESSION_TTL_HOURS=168
BISA_MAX_JSON_BYTES=524288
BISA_ACCESS_TOKEN_MINUTES=20
BISA_REFRESH_TOKEN_DAYS=30
BISA_LOGIN_MAX_ATTEMPTS=5
BISA_LOGIN_SOURCE_MAX_ATTEMPTS=50
BISA_LOGIN_WINDOW_SECONDS=900
BISA_LOGIN_LOCK_SECONDS=900
# Development/test only. Production must use invite_only until a real OTP
# adapter is implemented and approved.
BISA_PHONE_VERIFICATION_MODE=development_bypass
BISA_AUTH_PEPPER=
BISA_MEDIA_SIGNING_KEY=
BISA_MEDIA_URL_MAX_TTL_SECONDS=900
BISA_PRIVATE_MEDIA_MAX_BYTES=10485760
BISA_BACKUP_MAX_FILES=100000
BISA_BACKUP_MAX_ENTRY_BYTES=2147483648
BISA_BACKUP_MAX_TOTAL_BYTES=21474836480

# Use persistent, BISA-only paths in production.
BISA_DATA_DIR=./data-bisa
BISA_DB_PATH=./data-bisa/bisa.sqlite3
BISA_UPLOAD_DIR=./data-bisa/uploads
BISA_BACKUP_DIR=./data-bisa/backups

# Must remain false outside an isolated local demo database.
BISA_SEED_SAMPLE_DATA=false
# Required only when the isolated sample seed above is true. Choose locally;
# never commit or reuse the value.
BISA_DEMO_PIN=

# External adapters intentionally remain unavailable until both a real adapter
# implementation and its complete credential group are configured.
BISA_WHATSAPP_PHONE_NUMBER_ID=
BISA_WHATSAPP_ACCESS_TOKEN=
BISA_PAYMENT_GATEWAY=unconfigured
BISA_PAYMENT_WEBHOOK_SECRET=
BISA_VAPID_PUBLIC_KEY=
BISA_VAPID_PRIVATE_KEY=
BISA_VAPID_SUBJECT=
# Keep false until a real browser/device delivery test is approved and passed.
BISA_PUSH_REQUIRED=false
BISA_PUSH_POLL_SECONDS=8
BISA_PUSH_BATCH_SIZE=20
BISA_SMTP_HOST=
BISA_SMTP_PORT=587
BISA_SMTP_USER=
BISA_SMTP_PASSWORD=
BISA_SMTP_FROM_EMAIL=
